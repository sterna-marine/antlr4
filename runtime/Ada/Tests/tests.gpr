with "config/tests_config.gpr";
project tests is

   for Source_Dirs use ("src/**", "config/",
                        "lib/AdafDevtTestUnit/src/**");
   for Object_Dir use "../bld/" & Tests_Config.Build_Profile & "/obj";
   for Exec_Dir use "../bld/" & Tests_Config.Build_Profile & "/bin";
   for Create_Missing_Dirs use "True";
   for Main use (
      "TokenStreamRewriterTests.adb",
      "TokenStreamTests.adb",
      "VisitorTests.adb");

   package Compiler is
      for Default_Switches ("Ada") use Tests_Config.Ada_Compiler_Switches;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end tests;
