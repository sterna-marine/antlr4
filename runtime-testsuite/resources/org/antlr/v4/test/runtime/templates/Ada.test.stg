procedure Foo is
begin
	Text_IO.Put ("foo");
end Foo;
>>

Invoke_foo() ::= "Foo;"

Declare_pred() ::= <<
function pred (v: Boolean) return Boolean is
begin
	Text_IO.Put ("eval=\(v)");
	return v;
end pred;
>>

StringType() ::= "String"
Invoke_pred(v) ::= <<self.pred(<v>)>>
